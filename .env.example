# Origen del backend, **sin** `/api` (la capa API compone `/api/v1/...` y
# `/sanctum/csrf-cookie`). Ver `src/core/api/config.ts`.
#
# `VITE_*` acaba en el bundle: aquí no van secretos. En la imagen se puede
# sobreescribir en runtime con `window.__APP_CONFIG__.apiUrl`.
VITE_API_URL=http://localhost:8000
